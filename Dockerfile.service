ARG MODULE
ARG PORT=8080

FROM maven:3.9-eclipse-temurin-17 AS build
ARG MODULE
WORKDIR /build

# 使用阿里云 Maven 镜像加速（国内网络）
COPY docker-settings.xml /root/.m2/settings.xml

COPY . .
RUN mvn clean package -DskipTests -pl ${MODULE} -am -q

FROM eclipse-temurin:17-jre
ARG MODULE
ARG PORT
WORKDIR /app
COPY --from=build /build/${MODULE}/target/*.jar app.jar
EXPOSE ${PORT}
# JDK17 模块化限制: hessian2 反序列化需访问 java.math.BigInteger 内部字段, 必须 --add-opens
# 基础设施地址通过环境变量注入: NACOS_ADDR / REDIS_HOST / MYSQL_HOST / MYSQL_PASSWORD / GATEWAY_SECRET
ENV NACOS_ADDR=nacos \
    REDIS_HOST=redis \
    MYSQL_HOST=host.docker.internal \
    MYSQL_PASSWORD=root \
    GATEWAY_SECRET=tlive-dev-secret
ENTRYPOINT ["java", "--add-opens", "java.base/java.lang=ALL-UNNAMED", "--add-opens", "java.base/java.math=ALL-UNNAMED", "-jar", "app.jar"]
